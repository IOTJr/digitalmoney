# Example environment variables for local development and Vercel
# Copy values into your Vercel Project > Settings > Environment Variables (Production & Preview)

# Dodo Payments
# Get from your Dodo dashboard (secret key)
DODO_PAYMENTS_API_KEY=your_dodo_secret_key_here
# Optional: webhook secret (set in Dodo dashboard when creating webhook)
DODO_PAYMENTS_WEBHOOK_SECRET=your_dodo_webhook_secret_here
# Optional override if using a non-default base URL
DODO_PAYMENTS_BASE_URL=

# App URL (used for redirects and webhook callback construction)
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Supabase (project settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_public_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# M-Pesa (Safaricom Daraja)
# MPESA_ENV: sandbox or live
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_mpesa_passkey
# Shared secret used to validate MPesa callback: choose a long random value
MPESA_CALLBACK_TOKEN=long_random_token_here
# Transaction type used for STK Push
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# Optional fallback exchange rate (USD -> KES) if external API fails
STATIC_USD_TO_KES_RATE=140

# NEXT: copy these keys into Vercel (Project Settings > Environment Variables).
# For `MPESA_CALLBACK_TOKEN`, set the Daraja callback URL in Safaricom to:
# https://<your-domain>/api/webhooks/mpesa?token=<MPESA_CALLBACK_TOKEN>
